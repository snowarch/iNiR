    {
      "id": "material",
      "name": "Material",
      "description": "Windows rise into place and sink away.",
      "keywords": [
        "material you",
        "slide",
        "rise",
        "shader",
        "android"
      ],
      "credit": "cnvuls (PR #205)",
      "types": {
        "workspace-switch": {
          "spring": [
            0.88,
            750,
            0.0001
          ]
        },
        "window-open": {
          "duration-ms": 280,
          "curve": "cubic-bezier",
          "curve-args": [
            0.05,
            0.7,
            0.1,
            1
          ],
          "custom-shader": "vec4 open_color(vec3 coords_geo, vec3 size_geo) {\n    float p = niri_clamped_progress;\n\n    // Slight up-to-down settle.\n    float slide_px = (1.0 - p) * 60.0;\n    float slide_geo = slide_px / max(size_geo.x, 1.0);\n\n    // Very subtle scale-up into place.\n    float scale = 0.985 + 0.015 * p;\n\n    vec2 uv = coords_geo.xy;\n    uv -= vec2(0.5, 0.5);\n    uv /= scale;\n    uv += vec2(0.5, 0.5);\n\n    uv.y -= slide_geo;\n\n    vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);\n    vec4 color = texture2D(niri_tex, coords_tex.st);\n\n    // Gentle fade-in.\n    color *= p;\n\n    return color;\n}\n"
        },
        "window-close": {
          "duration-ms": 200,
          "curve": "cubic-bezier",
          "curve-args": [
            0.3,
            0,
            0.8,
            0.15
          ],
          "custom-shader": "vec4 close_color(vec3 coords_geo, vec3 size_geo) {\n    float p = niri_clamped_progress;\n    float inv = 1.0 - p;\n\n    // Slight downward departure.\n    float slide_px = p * 40.0;\n    float slide_geo = slide_px / max(size_geo.x, 1.0);\n\n    // Tiny scale-down on exit.\n    float scale = 1.0 - 0.012 * p;\n\n    vec2 uv = coords_geo.xy;\n    uv -= vec2(0.5, 0.5);\n    uv /= scale;\n    uv += vec2(0.5, 0.5);\n\n    uv.y -= slide_geo;\n\n    vec3 coords_tex = niri_geo_to_tex * vec3(uv, 1.0);\n    vec4 color = texture2D(niri_tex, coords_tex.st);\n\n    color *= inv;\n    return color;\n}\n"
        },
        "horizontal-view-movement": {
          "spring": [
            0.82,
            750,
            0.0001
          ]
        },
        "window-movement": {
          "spring": [
            0.78,
            850,
            0.0001
          ]
        },
        "window-resize": {
          "spring": [
            0.82,
            750,
            0.0001
          ]
        },
        "config-notification-open-close": {
          "spring": [
            0.7,
            1000,
            0.001
          ]
        },
        "screenshot-ui-open": {
          "duration-ms": 250,
          "curve": "cubic-bezier",
          "curve-args": [
            0.2,
            0,
            0,
            1
          ]
        },
        "overview-open-close": {
          "spring": [
            0.82,
            750,
            0.0001
          ]
        },
        "recent-windows-close": {
          "spring": [
            1.0,
            900,
            0.001
          ]
        }
      }
