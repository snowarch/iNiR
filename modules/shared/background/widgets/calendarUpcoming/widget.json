{
  "name": "Up next",
  "group": "Upcoming Events",
  "main": "CalendarUpcomingWidget.qml",
  "icon": "event",
  "tint": "#ff3b30",
  "category": "today",
  "keywords": "agenda events next up",
  "sizes": ["medium", "small", "large"],
  "freeShape": true,
  "lock": true,
  "palette": true,
  "face": "agenda",
  "defaultConfig": {
    "placementStrategy": "free",
    "maxEvents": 5,
    "showDate": true,
    "showTime": true,
    "showLocation": false,
    "groupByDay": true,
    "style": "card",
    "widgetScale": 100,
    "widgetOpacity": 100,
    "useBlur": false,
    "backgroundOpacity": 0.1,
    "borderWidth": 1,
    "borderOpacity": 0.12,
    "cornerRadius": -1,
    "colorMode": "auto",
    "dim": 0,
    "x": 80,
    "y": 80
  },
  "options": [
    {"key":"groupByDay","label":"Group by day","type":"switch","default":true},
    {"key":"showLocation","label":"Location","type":"switch","default":false},
    {"key":"showDate","label":"Show date","type":"switch","default":true,"when":"plain"},
    {"key":"showTime","label":"Show time","type":"switch","default":true,"when":"plain"},
    {"key":"maxEvents","label":"Maximum events","type":"range","default":5,"when":"plain","min":1,"max":12},
    {"key":"style","label":"Presentation","type":"choice","default":"card","when":"material","choices":[["card","Card"],["instrument","Instrument"]]}
  ]
}
