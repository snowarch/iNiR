{
  "name": "Clock",
  "group": "Clock",
  "main": "ClockWidget.qml",
  "icon": "schedule",
  "tint": "#ff9f0a",
  "category": "today",
  "keywords": "time hour watch",
  "sizes": ["medium", "small", "large"],
  "defaultOn": true,
  "lock": true,
  "palette": true,
  "face": "clock",
  "defaultConfig": {
    "placementStrategy": "free",
    "style": "digital",
    "fontFamily": "Space Grotesk",
    "timeFormat": "system",
    "showSeconds": false,
    "showDate": true,
    "dateStyle": "long",
    "instrumentTrail": true,
    "instrumentTrailLength": 6,
    "instrumentNumerals": true,
    "timeScale": 100,
    "dateScale": 100,
    "showShadow": true,
    "dim": 0,
    "digital.adaptToWallpaper": true,
    "digital.animateChange": true,
    "digital.fontWeight": 600,
    "digital.spacing": 6,
    "digital.preset": "default",
    "pixel.orientation": "horizontal",
    "cookie.aiStyling": false,
    "cookie.constantlyRotate": false,
    "cookie.dateInClock": true,
    "cookie.dateStyle": "bubble",
    "cookie.dialNumberStyle": "full",
    "cookie.hourHandStyle": "hollow",
    "cookie.hourMarks": false,
    "cookie.minuteHandStyle": "hide",
    "cookie.secondHandStyle": "hide",
    "cookie.sides": 15,
    "cookie.timeIndicators": false,
    "cookie.useSineCookie": false,
    "cookie.size": 230,
    "cookie.preset": "default",
    "quote.enable": false,
    "quote.text": "",
    "widgetScale": 100,
    "widgetOpacity": 100,
    "colorMode": "auto",
    "useBlur": false,
    "backgroundOpacity": 0,
    "borderWidth": 0,
    "borderOpacity": 0.08,
    "cornerRadius": -1,
    "x": 100,
    "y": 100
  },
  "bare": true,
  "options": [
    {"key":"style","label":"Clock style","type":"choice","default":"digital","when":"material","choices":[["digital","Digital"],["androidStacked","Android stacked"],["cookie","Cookie"],["pixel","Pixel"],["instrument","Instrument"]]},
    {"key":"pixel.orientation","label":"Orientation","type":"choice","default":"horizontal","when":["material",{"style":"pixel"}],"choices":[["horizontal","Horizontal"],["vertical","Vertical"]]},
    {"key":"timeFormat","label":"Time format","type":"choice","default":"system","when":{"any":[["material",{"style":["digital","androidStacked"]}],["face",{"iris.face":"digital"}]]},"choices":[["system","System"],["24h","24h"],["12h","12h"]]},
    {"key":"dateStyle","label":"Date style","type":"choice","default":"long","when":["material",{"style":"digital"}],"tune":true,"choices":[["long","Long"],["minimal","Minimal"],["weekday","Weekday"],["numeric","Numeric"]]},
    {"key":"digital.preset","label":"Digital preset","type":"choice","default":"default","when":["material",{"style":"digital"}],"tune":true,"choices":[["default","Default"],["light","Light"],["bold","Bold"],["mono","Mono"]],"sets":{"default":{"digital.fontWeight":600,"digital.spacing":6},"light":{"digital.fontWeight":300,"digital.spacing":8},"bold":{"digital.fontWeight":800,"digital.spacing":4},"mono":{"digital.fontWeight":500,"digital.spacing":2}}},
    {"key":"showSeconds","label":"Seconds","type":"switch","default":false,"when":["plain",{"style":["digital","androidStacked","instrument"]}]},
    {"key":"showDate","label":"Date","type":"switch","default":true,"when":["plain",{"style":["digital","androidStacked","instrument"]}]},
    {"key":"showShadow","label":"Shadow","type":"switch","default":true,"when":["material",{"style":["digital","androidStacked"]}],"tune":true},
    {"key":"digital.animateChange","label":"Animate","type":"switch","default":true,"when":["material",{"style":["digital","androidStacked"]}],"tune":true},
    {"key":"digital.adaptToWallpaper","label":"Adapt digital clock locally","type":"switch","default":true,"when":["material",{"style":"digital"}],"tune":true},
    {"key":"digital.fontWeight","label":"Font weight","type":"range","default":600,"when":["material",{"style":"digital"}],"min":100,"max":900,"step":100},
    {"key":"digital.spacing","label":"Spacing","type":"range","default":6,"when":["material",{"style":"digital"}],"min":0,"max":20,"unit":" px"},
    {"key":"timeScale","label":"Time scale","type":"range","default":100,"when":"plain","min":50,"max":200,"step":5,"unit":" %"},
    {"key":"dateScale","label":"Date scale","type":"range","default":100,"when":"material","min":50,"max":200,"step":5,"unit":" %"},
    {"key":"fontFamily","label":"Clock font","type":"text","default":"Space Grotesk","when":["material",{"style":["digital","androidStacked"]}],"tune":true,"placeholder":"Space Grotesk"},
    {"key":"cookie.preset","label":"Preset","type":"choice","default":"default","when":["material",{"style":"cookie"}],"choices":[["default","Default"],["compact","Compact"],["large","Large"],["minimal","Minimal"]],"sets":{"default":{"cookie.size":230,"cookie.sides":15,"cookie.dialNumberStyle":"full","cookie.hourHandStyle":"hollow"},"compact":{"cookie.size":160,"cookie.sides":12,"cookie.dialNumberStyle":"dots","cookie.hourHandStyle":"fill"},"large":{"cookie.size":300,"cookie.sides":18,"cookie.dialNumberStyle":"numbers","cookie.hourHandStyle":"classic"},"minimal":{"cookie.size":200,"cookie.sides":6,"cookie.dialNumberStyle":"none","cookie.hourHandStyle":"fill"}}},
    {"key":"cookie.size","label":"Dial size","type":"range","default":230,"when":["material",{"style":"cookie"}],"min":100,"max":400,"step":10,"unit":" px"},
    {"key":"cookie.sides","label":"Sides","type":"range","default":15,"when":["material",{"style":"cookie"}],"min":3,"max":30},
    {"key":"cookie.useSineCookie","label":"Sine wave shape","type":"switch","default":false,"when":["material",{"style":"cookie"}],"tune":true},
    {"key":"cookie.constantlyRotate","label":"Constant rotation","type":"switch","default":false,"when":["material",{"style":"cookie"}],"tune":true},
    {"key":"cookie.dialNumberStyle","label":"Dial style","type":"choice","default":"full","when":["material",{"style":"cookie"}],"tune":true,"choices":[["full","Lines"],["dots","Dots"],["numbers","Numbers"],["none","None"]]},
    {"key":"cookie.hourMarks","label":"Hour marks","type":"switch","default":false,"when":["material",{"style":"cookie"}],"tune":true},
    {"key":"cookie.timeIndicators","label":"Time column","type":"switch","default":false,"when":["material",{"style":"cookie"}],"tune":true},
    {"key":"cookie.hourHandStyle","label":"Hour hand","type":"choice","default":"hollow","when":["material",{"style":"cookie"}],"tune":true,"choices":[["fill","Fill"],["hollow","Hollow"],["classic","Classic"],["hide","Hide"]]},
    {"key":"cookie.minuteHandStyle","label":"Minute hand","type":"choice","default":"hide","when":["material",{"style":"cookie"}],"tune":true,"choices":[["bold","Bold"],["medium","Medium"],["thin","Thin"],["hide","Hide"]]},
    {"key":"cookie.secondHandStyle","label":"Second hand","type":"choice","default":"hide","when":["material",{"style":"cookie"}],"tune":true,"choices":[["classic","Classic"],["dot","Dot"],["line","Line"],["hide","Hide"]]},
    {"key":"cookie.dateStyle","label":"Date indicator","type":"choice","default":"bubble","when":["material",{"style":"cookie"}],"tune":true,"choices":[["bubble","Bubble"],["rect","Rectangle"],["border","Border"],["hide","Hide"]]},
    {"key":"cookie.aiStyling","label":"Auto-style from wallpaper","type":"switch","default":false,"when":["material",{"style":"cookie"}],"tune":true},
    {"key":"instrumentTrail","label":"Minute trail","type":"switch","default":true,"when":["plain",{"style":"instrument"}]},
    {"key":"instrumentNumerals","label":"Numerals","type":"switch","default":true,"when":["plain",{"style":"instrument"}]},
    {"key":"instrumentTrailLength","label":"Trail length","type":"range","default":6,"when":["plain",{"style":"instrument"},{"instrumentTrail":true}],"min":2,"max":15},
    {"key":"quote.enable","label":"Show quote","type":"switch","default":false,"when":["material",{"style":["digital","cookie"]}],"tune":true},
    {"key":"quote.text","label":"Quote","type":"text","default":"","when":["material",{"quote.enable":true}],"placeholder":"Enter a quote or message..."}
  ]
}
