{
  "name": "Date",
  "group": "Date badge",
  "main": "DateBadgeWidget.qml",
  "icon": "today",
  "tint": "#ff3b30",
  "category": "today",
  "keywords": "date day today",
  "sizes": ["small", "medium", "large"],
  "freeShape": true,
  "lock": true,
  "palette": true,
  "face": "date",
  "defaultConfig": {
    "placementStrategy": "free",
    "style": "ticket",
    "showYear": true,
    "showWeekday": true,
    "showOrdinal": true,
    "instrumentMarks": true,
    "widgetScale": 100,
    "widgetOpacity": 100,
    "colorMode": "auto",
    "dim": 0,
    "backgroundOpacity": 0.16,
    "borderWidth": 1,
    "borderOpacity": 0.2,
    "cornerRadius": -1,
    "useBlur": false,
    "x": 260,
    "y": 80
  },
  "options": [
    {"key":"showWeekday","label":"Weekday","type":"switch","default":true},
    {"key":"showYear","label":"Year","type":"switch","default":true},
    {"key":"showOrdinal","label":"Day of the year","type":"switch","default":true},
    {"key":"style","label":"Style","type":"choice","default":"ticket","when":"material","choices":[["ticket","Ticket"],["stacked","Stacked"],["seal","Seal"],["instrument","Instrument"]]},
    {"key":"instrumentMarks","label":"Marks","type":"switch","default":true,"when":["plain",{"style":"instrument"}],"tune":true}
  ]
}
