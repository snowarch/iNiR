  "bare": true,
  "options": [
    {"key":"preset","label":"Layout presets","type":"choice","default":"exhibition","choices":[["exhibition","Exhibition"],["magazine","Magazine"],["minimal","Minimal"],["traditional","Traditional"]],"write":"japanese.layout"},
    {"key":"primaryText","label":"Lead title","type":"text","default":"夏の記憶","placeholder":"夏の記憶"},
    {"key":"secondaryText","label":"Secondary vertical copy","type":"text","default":"潮風と、あの子と、終わらない夏","placeholder":"潮風と、あの子と、終わらない夏"},
    {"key":"sealText","label":"Seal text","type":"text","default":"特別展","placeholder":"特別展"},
    {"key":"footerText","label":"Footer label","type":"text","default":"PACIFIC DRIVE-IN","placeholder":"PACIFIC DRIVE-IN"},
    {"key":"dateText","label":"Date or edition line","type":"text","default":"7.12 — 8.31","placeholder":"7.12 — 8.31"},
    {"key":"showSecondary","label":"Show secondary vertical copy","type":"switch","default":true,"tune":false,"write":"japanese.composition"},
    {"key":"showSeal","label":"Show exhibition seal","type":"switch","default":true,"tune":false,"write":"japanese.composition"},
    {"key":"showFooter","label":"Show footer and date","type":"switch","default":true,"tune":false,"write":"japanese.composition"},
    {"key":"showRule","label":"Show editorial rule","type":"switch","default":true,"when":{"showFooter":true},"tune":false,"write":"japanese.composition"},
    {"key":"mirrorLayout","label":"Mirror composition","type":"switch","default":false,"tune":true,"write":"japanese.composition"},
    {"key":"rotateLatin","label":"Rotate Latin characters vertically","type":"switch","default":false,"tune":true,"write":"japanese.composition"},
    {"key":"fontPreset","label":"Type direction","type":"choice","default":"mincho","choices":[["mincho","Mincho"],["mixed","Mixed"],["gothic","Gothic"]],"write":"japanese.type"},
    {"key":"palettePreset","label":"Color source","type":"choice","default":"adaptive","choices":[["adaptive","Wallpaper adaptive"],["sumi","Sumi"],["ivory","Ivory"],["sunset","Sunset"],["cinema","Cinema"],["custom","Manual roles"]],"write":"japanese.colours"},
    {"key":"primaryColor","label":"Lead title","type":"text","default":"#E7D4B2","when":{"paletteMode":"manual"},"tune":true,"placeholder":"#E7D4B2","part":"Colours","write":"japanese.palette"},
    {"key":"secondaryColor","label":"Secondary copy","type":"text","default":"#CDB48D","when":{"paletteMode":"manual"},"tune":true,"placeholder":"#CDB48D","part":"Colours","write":"japanese.palette"},
    {"key":"sealColor","label":"Seal","type":"text","default":"#A64B39","when":{"paletteMode":"manual"},"tune":true,"placeholder":"#A64B39","part":"Colours","write":"japanese.palette"},
    {"key":"detailColor","label":"Footer and date","type":"text","default":"#D0B996","when":{"paletteMode":"manual"},"tune":true,"placeholder":"#D0B996","part":"Colours","write":"japanese.palette"},
    {"key":"ruleColor","label":"Editorial rule","type":"text","default":"#C18A53","when":{"paletteMode":"manual"},"tune":true,"placeholder":"#C18A53","part":"Colours","write":"japanese.palette"},
    {"key":"fontFamily","label":"Lead title font","type":"text","default":"serif","tune":true,"placeholder":"serif","part":"Type","write":"japanese.font"},
    {"key":"secondaryFontFamily","label":"Secondary font","type":"choice","default":"","tune":true,"choices":[["","Same as title"],["serif","Serif / Mincho"],["sans-serif","Sans / Gothic"],["monospace","Monospace"]],"part":"Type","write":"japanese.font"},
    {"key":"latinFontFamily","label":"Footer font","type":"choice","default":"","tune":true,"choices":[["","Interface font"],["serif","Serif"],["sans-serif","Sans"],["monospace","Monospace"]],"part":"Type","write":"japanese.font"},
    {"key":"primaryWeight","label":"Lead weight","type":"range","default":500,"min":100,"max":900,"step":100,"unit":"","part":"Type","write":"japanese.font"},
    {"key":"secondaryWeight","label":"Secondary weight","type":"range","default":400,"min":100,"max":900,"step":100,"unit":"","part":"Type","write":"japanese.font"},
    {"key":"latinWeight","label":"Footer weight","type":"range","default":600,"min":100,"max":900,"step":100,"unit":"","part":"Type","write":"japanese.font"},
    {"key":"primarySize","label":"Lead size","type":"range","default":72,"min":28,"max":140,"step":2,"unit":" px","part":"Type","write":"japanese.composition"},
    {"key":"secondarySize","label":"Secondary size","type":"range","default":18,"min":10,"max":48,"step":1,"unit":" px","part":"Type","write":"japanese.composition"},
    {"key":"footerSize","label":"Footer size","type":"range","default":14,"min":8,"max":32,"step":1,"unit":" px","part":"Type","write":"japanese.composition"},
    {"key":"dateSize","label":"Date size","type":"range","default":12,"min":8,"max":28,"step":1,"unit":" px","part":"Type","write":"japanese.composition"},
    {"key":"primaryColumns","label":"Lead columns","type":"range","default":2,"min":1,"max":4,"step":1,"unit":"","part":"Type","write":"japanese.composition"},
    {"key":"secondaryColumns","label":"Secondary columns","type":"range","default":2,"min":1,"max":5,"step":1,"unit":"","part":"Type","write":"japanese.composition"},
    {"key":"columnGap","label":"Column gap","type":"range","default":14,"min":4,"max":48,"step":1,"unit":" px","part":"Type","write":"japanese.composition"},
    {"key":"letterSpacing","label":"Lead spacing","type":"range","default":2,"min":0,"max":20,"step":1,"unit":" px","part":"Type","write":"japanese.font"},
    {"key":"secondaryLetterSpacing","label":"Secondary spacing","type":"range","default":1,"min":0,"max":20,"step":1,"unit":" px","part":"Type","write":"japanese.font"},
    {"key":"primaryOpacity","label":"Lead opacity","type":"range","default":100,"min":10,"max":100,"step":5,"unit":" %","part":"Colours","write":"japanese.palette"},
    {"key":"secondaryOpacity","label":"Secondary opacity","type":"range","default":78,"min":10,"max":100,"step":5,"unit":" %","part":"Colours","write":"japanese.palette"},
    {"key":"sealOpacity","label":"Seal opacity","type":"range","default":100,"min":10,"max":100,"step":5,"unit":" %","part":"Colours","write":"japanese.palette"},
    {"key":"detailOpacity","label":"Detail opacity","type":"range","default":72,"min":10,"max":100,"step":5,"unit":" %","part":"Colours","write":"japanese.palette"},
    {"key":"ruleOpacity","label":"Rule opacity","type":"range","default":78,"min":10,"max":100,"step":5,"unit":" %","part":"Colours","write":"japanese.palette"},
    {"key":"ruleThickness","label":"Rule thickness","type":"range","default":1,"min":1,"max":6,"step":1,"unit":" px","part":"Type","write":"japanese.composition"},
    {"key":"sealFillOpacity","label":"Seal fill","type":"range","default":0,"min":0,"max":100,"step":5,"unit":" %","part":"Colours","write":"japanese.palette"},
    {"key":"shadowStrength","label":"Wallpaper shadow","type":"range","default":35,"min":0,"max":100,"step":5,"unit":" %","part":"Colours","write":"japanese.palette"},
    {"key":"outlineOpacity","label":"Text outline","type":"range","default":0,"min":0,"max":100,"step":5,"unit":" %","part":"Colours","write":"japanese.palette"},
    {"key":"outlineColor","label":"Outline color","type":"text","default":"#000000","when":{"outlineOpacity":{"above":0}},"placeholder":"#000000","part":"Colours"}
  ]
