{
  "name": "Calendar",
  "group": "Month Calendar",
  "main": "MonthCalendarWidget.qml",
  "icon": "calendar_month",
  "tint": "#ff3b30",
  "category": "today",
  "keywords": "calendar month date days",
  "sizes": ["large", "small", "medium"],
  "lock": true,
  "palette": true,
  "face": "calendar",
  "defaultConfig": {
    "placementStrategy": "free",
    "weekStart": 1,
    "showAdjacentDays": true,
    "style": "card",
    "instrumentRule": true,
    "widgetScale": 100,
    "widgetOpacity": 100,
    "showBackground": true,
    "useBlur": false,
    "showBorder": true,
    "backgroundOpacity": 0.14,
    "borderWidth": 1,
    "borderOpacity": 0.16,
    "cornerRadius": -1,
    "colorMode": "auto",
    "dim": 0,
    "x": 420,
    "y": 120
  },
  "options": [
    {"key":"weekStart","label":"Week starts on","type":"choice","default":1,"choices":[[1,"Monday"],[0,"Sunday"]]},
    {"key":"showAdjacentDays","label":"Show adjacent month days","type":"switch","default":true},
    {"key":"style","label":"Style","type":"choice","default":"card","when":"material","choices":[["card","Card"],["instrument","Instrument"]]},
    {"key":"instrumentRule","label":"Header rule","type":"switch","default":true,"when":["plain",{"style":"instrument"}],"tune":true}
  ]
}
