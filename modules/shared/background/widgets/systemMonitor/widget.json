{
  "name": "Vitals",
  "group": "System Monitor",
  "main": "SystemMonitorWidget.qml",
  "icon": "monitor_heart",
  "tint": "#34c759",
  "category": "system",
  "keywords": "vitals cpu gpu ram memory temperature performance",
  "sizes": ["medium", "small", "large"],
  "lock": true,
  "palette": true,
  "face": "vitals",
  "defaultConfig": {
    "placementStrategy": "free",
    "preset": "default",
    "displayMode": "bars",
    "barCount": 32,
    "barSpacing": 2,
    "trackAlpha": 0.08,
    "fillOpacity": 0.7,
    "graphFillOpacity": 0.3,
    "showCpu": true,
    "showMemory": true,
    "showGpu": true,
    "showTemp": false,
    "showGpuTemp": false,
    "showDisk": false,
    "showLabels": true,
    "dim": 0,
    "widgetScale": 100,
    "widgetOpacity": 100,
    "colorMode": "auto",
    "useBlur": false,
    "backgroundOpacity": 0.16,
    "borderWidth": 1,
    "borderOpacity": 0.2,
    "cornerRadius": -1,
    "x": 50,
    "y": 400
  },
  "options": [
    {"key":"showCpu","label":"CPU","type":"switch","default":true,"keywords":["monitor","usage","temperature","temp"]},
    {"key":"showMemory","label":"Memory","type":"switch","default":true,"keywords":["monitor","usage","temperature","temp"]},
    {"key":"showGpu","label":"GPU","type":"switch","default":true,"keywords":["monitor","usage","temperature","temp"]},
    {"key":"showTemp","label":"CPU heat","type":"switch","default":false,"keywords":["monitor","usage","temperature","temp"]},
    {"key":"showGpuTemp","label":"GPU heat","type":"switch","default":false,"keywords":["monitor","usage","temperature","temp"]},
    {"key":"showDisk","label":"Disk","type":"switch","default":false,"keywords":["monitor","usage","temperature","temp"]},
    {"key":"showLabels","label":"Labels and percentages","type":"switch","default":true,"when":"plain"},
    {"key":"displayMode","label":"Display mode","type":"choice","default":"bars","when":"material","choices":[["bars","Bars"],["graph","Graph"],["rings","Rings"],["text","Text"],["tiles","Tiles"],["instrument","Instrument"]]},
    {"key":"trackAlpha","label":"Track opacity","type":"range","default":0.08,"when":"material","min":0,"max":0.5,"step":0.02,"scale":100,"unit":" %"},
    {"key":"fillOpacity","label":"Fill opacity","type":"range","default":0.7,"when":"material","min":0.1,"max":1,"step":0.05,"scale":100,"unit":" %"},
    {"key":"graphFillOpacity","label":"Graph fill opacity","type":"range","default":0.3,"when":["material",{"displayMode":"graph"}],"min":0,"max":1,"step":0.05,"scale":100,"unit":" %"}
  ]
}
