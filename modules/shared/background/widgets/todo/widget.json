{
  "name": "Tasks",
  "group": "Todo",
  "main": "TodoWidget.qml",
  "icon": "checklist",
  "tint": "#ff9f0a",
  "category": "notes",
  "keywords": "tasks checklist list",
  "sizes": ["large", "small", "medium"],
  "lock": true,
  "palette": true,
  "face": "todo",
  "defaultConfig": {
    "placementStrategy": "free",
    "widgetScale": 100,
    "widgetOpacity": 100,
    "style": "card",
    "instrumentRules": true,
    "showCompleted": true,
    "useBlur": false,
    "backgroundOpacity": 0.14,
    "borderWidth": 1,
    "borderOpacity": 0.16,
    "cornerRadius": -1,
    "colorMode": "auto",
    "dim": 0,
    "x": 120,
    "y": 180
  },
  "options": [
    {"key":"showCompleted","label":"Show completed tasks","type":"switch","default":true},
    {"key":"style","label":"Presentation","type":"choice","default":"card","when":"material","choices":[["card","Card"],["instrument","Instrument"]]},
    {"key":"instrumentRules","label":"Row rules","type":"switch","default":true,"when":["plain",{"style":"instrument"}],"tune":true}
  ]
}
