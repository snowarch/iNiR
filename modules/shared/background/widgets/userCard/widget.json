{
  "name": "Profile",
  "group": "User card",
  "main": "UserCardWidget.qml",
  "icon": "account_circle",
  "tint": "#0a84ff",
  "category": "system",
  "keywords": "profile avatar account you",
  "sizes": ["medium", "small", "large"],
  "lock": true,
  "palette": true,
  "face": "profile",
  "defaultConfig": {
    "placementStrategy": "free",
    "widgetScale": 100,
    "widgetOpacity": 100,
    "colorMode": "auto",
    "dim": 0,
    "showBackground": true,
    "showBorder": true,
    "backgroundOpacity": 0.16,
    "borderWidth": 1,
    "borderOpacity": 0.2,
    "cornerRadius": -1,
    "useBlur": false,
    "style": "card",
    "showAvatar": true,
    "showWeather": true,
    "showHostname": true,
    "x": 80,
    "y": 420
  },
  "options": [
    {"key":"showAvatar","label":"Picture","type":"switch","default":true},
    {"key":"showWeather","label":"Weather","type":"switch","default":true,"when":{"any":[["face",{"sizeClass":"large"}],[{"not":"face"},{"not":{"sizeClass":"small"}}]]}},
    {"key":"showHostname","label":"Computer name","type":"switch","default":true,"when":{"any":["face",{"not":{"sizeClass":"small"}}]}},
    {"key":"style","label":"Presentation","type":"choice","default":"card","when":"material","choices":[["card","Card"],["instrument","Instrument"]]}
  ]
}
