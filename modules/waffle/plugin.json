{
  "id": "waffle",
  "kind": "family",
  "name": "Waffle",
  "summary": "Windows 11 for people who want it: taskbar, Start, Action Center.",
  "version": "2.33.0",
  "provides": "modules/waffle",
  "parts": {
    "critical": "critical/ShellWaffleCriticalPanels.qml",
    "panels": "ShellWafflePanelsImpl.qml",
    "closeConfirm": "closeConfirm/WCloseConfirmContent.qml",
    "lockSurface": "lock/WaffleLockSurfaceSafe.qml",
    "lockSurface.hyprland": "lock/WaffleLockSurface.qml",
    "style": "WaffleFamilyStyle.qml",
    "regionToolbar": "regionSelector/WOptionsToolbar.qml",
    "familyTransition": "WaffleFamilyTransition.qml",
    "settingsApp": "settings/WaffleSettingsApp.qml",
    "config": "WaffleConfigSchema.qml",
    "layout": "WaffleLayout.qml"
  },
  "settingsFrom": {
    "family": "ii",
    "when": "waffles.settings.useMaterialStyle"
  },
  "customWidget": {
    "face": "widgets/templates/WaffleCard.qml"
  },
  "configKey": "waffles",
  "enabledPanels": [
    "wBar",
    "wBackground",
    "wBackdrop",
    "wStartMenu",
    "wActionCenter",
    "wNotificationCenter",
    "wNotificationPopup",
    "wOnScreenDisplay",
    "wWidgets",
    "wTaskView",
    "wLock",
    "wPolkit",
    "wSessionScreen",
    "iiBootGreeting",
    "iiCheatsheet",
    "iiOnScreenKeyboard",
    "iiOverlay",
    "iiOverview",
    "iiRegionSelector",
    "iiScreenCorners",
    "iiWallpaperSelector",
    "iiWallpaperLauncher",
    "iiCoverflowSelector",
    "iiClipboard",
    "iiShellUpdate",
    "iiMascotCompanion"
  ],
  "flags": {
    "verbs": true,
    "taskbarSorting": true
  },
  "settings": {
    "wallpaper": {
      "key": "waffles.background"
    },
    "font": {
      "key": "waffles.theming.font.family",
      "fallback": "Noto Sans"
    }
  },
  "devDestinations": [
    {
      "id": "waffle/start",
      "surface": "waffle-search",
      "view": "start",
      "settleMs": 350
    },
    {
      "id": "waffle/all-apps",
      "surface": "waffle-search",
      "view": "all-apps",
      "settleMs": 350
    },
    {
      "id": "waffle/search",
      "surface": "waffle-search",
      "view": "search",
      "settleMs": 450
    },
    {
      "id": "waffle/action-center",
      "surface": "waffle-action-center",
      "settleMs": 350
    },
    {
      "id": "waffle/notification-center",
      "surface": "waffle-notification-center",
      "settleMs": 350
    },
    {
      "id": "waffle/widgets",
      "surface": "waffle-widgets",
      "settleMs": 350
    },
    {
      "id": "waffle/taskview",
      "surface": "waffle-taskview",
      "settleMs": 450
    }
  ],
  "switch": {
    "name": "Switch to Waffle Panel Family",
    "description": "Use the Windows 11 / Waffle panel layout",
    "icon": "grid_view",
    "keywords": [
      "family",
      "panel",
      "waffle",
      "win11",
      "windows",
      "layout"
    ]
  }
}
