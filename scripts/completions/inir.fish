# Fish completion for inir CLI
# Install: inir completions install fish
# Or: inir completions fish > ~/.config/fish/completions/inir.fish

# The words after `inir`, `inir ipc` or `inir bind <keys>`: an IPC call being typed.
function __inir_call_words
    set -l words (commandline -opc)
    set -e words[1]
    if test (count $words) -ge 1; and test "$words[1]" = ipc
        set -e words[1]
    else if test (count $words) -ge 1; and test "$words[1]" = bind
        set -e words[1]
        while test (count $words) -ge 1; and string match -q -- '--*' "$words[1]"
            set -e words[1]
        end
        # The keys come first; with none typed yet there is no call.
        test (count $words) -ge 1; or return 1
        set -e words[1]
    end
    test (count $words) -gt 0; and printf '%s\n' $words
    return 0
end
# Nothing of the call typed yet: offer the targets.
function __inir_at_target
    set -l words (commandline -opc)
    if test (count $words) -ge 2; and not contains -- "$words[2]" ipc bind
        return 1
    end
    set -l w (__inir_call_words); or return 1
    test (count $w) -eq 0
end
# The target typed: offer its functions.
function __inir_at_function
    set -l w (__inir_call_words); or return 1
    test (count $w) -eq 1; and contains -- "$w[1]" $argv
end
# Target and function typed: offer the values it knows for each of its arguments.
function __inir_at_value -a nargs fn
    set -l targets $argv[3..-1]
    set -l w (__inir_call_words); or return 1
    test (count $w) -ge 2; and test (count $w) -le (math 1 + $nargs); and contains -- "$w[1]" $targets; and test "$w[2]" = "$fn"
end

