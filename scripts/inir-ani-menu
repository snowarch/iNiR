#!/bin/sh
# ani-cli asks its menu program for every choice: it pipes the list to stdin and
# passes the prompt as an argument (`-p <prompt>` when it believes this is rofi,
# the last argument otherwise), then reads the chosen line back. Inside an iNiR
# run (INIR_ANI_RUN) the question is written to the run directory and the answer
# the shell writes back is returned; that is how iNiR is the interface without
# touching how ani-cli finds anything.

prompt=""
while [ $# -gt 0 ]; do
    case "$1" in
        -p) prompt=$2; shift ;;
        *) [ -z "$prompt" ] && last=$1 ;;
    esac
    shift
done
[ -n "$prompt" ] || prompt=$last
list=$(cat -)

if [ -z "$INIR_ANI_RUN" ]; then
    case "$prompt" in
        "Playing episode"*) printf 'quit\n' ;;
        *) printf '%s\n' "$list" | head -n 1 ;;
    esac
    exit 0
fi

# A resume knows which show it wants: the entry whose title matches, never
# ani-cli's first result, and nothing at all when none matches.
if [ -n "$INIR_ANI_EXPECT" ] && [ "$prompt" = "Select anime: " ]; then
    printf '%s\n' "$list" | LC_ALL=C awk '
        function key(v) { v = tolower(v); gsub(/[^a-z0-9]+/, " ", v); sub(/^ /, "", v); sub(/ $/, "", v); return v }
        BEGIN { want = key(ENVIRON["INIR_ANI_EXPECT"]) }
        (i = index($0, " ")) && substr($0, i + 1) != "" && key(substr($0, i + 1)) == want { print substr($0, 1, i - 1); found = 1; exit }
        END { exit !found }'
    exit $?
fi

request="$INIR_ANI_RUN/request.json"
response="$INIR_ANI_RUN/response"
rm -f -- "$response"
staging=$(mktemp "$INIR_ANI_RUN/.request.XXXXXX") || exit 1
if printf '%s\n' "$list" | jq -R -n -c --arg prompt "$prompt" '{prompt: $prompt, items: [inputs | select(test("\\S"))]}' > "$staging"; then
    mv -f -- "$staging" "$request" || { rm -f -- "$staging"; exit 1; }
else
    rm -f -- "$staging"
    exit 1
fi

# The person is reading a list, not watching a progress bar: wait long, not forever.
deadline=$(( $(date +%s) + 600 ))
while [ "$(date +%s)" -lt "$deadline" ]; do
    if [ -f "$response" ]; then
        answer=$(cat -- "$response")
        rm -f -- "$response" "$request"
        [ -n "$answer" ] || exit 1
        printf '%s\n' "$answer"
        exit 0
    fi
    sleep 0.2
done
rm -f -- "$request"
exit 1
