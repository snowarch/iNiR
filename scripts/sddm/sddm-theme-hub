def parse_sddm_conf(conf_path):
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    try:
        cp.read(conf_path, encoding="utf-8")
    except Exception:
        pass
    
    def get(section, key, default):
        if cp.has_section(section) and cp.has_option(section, key):
            val = cp.get(section, key).strip().strip('"').strip("'")
            return val
        return default

    def get_int(section, key, default):
        try:
            return int(get(section, key, default))
        except:
            return default

    def get_float(section, key, default):
        try:
            return float(get(section, key, default))
        except:
            return default

    def get_bool(section, key, default):
        val = str(get(section, key, str(default))).lower()
        return val in ("true", "1", "yes")

    bg_lock = get("LockScreen", "background", "")
    bg_login = get("LoginScreen", "background", "")
    bg = bg_lock or bg_login or ""

    is_video = False
    if any(bg.lower().endswith(ext) for ext in [".mp4", ".webm", ".mkv", ".avi", ".mov"]):
        is_video = True

    return {
        "background": bg,
        "is_video": is_video,
        "lock_blur": get_int("LockScreen", "blur", 32),
        "lock_brightness": get_float("LockScreen", "brightness", 0.0),
        "lock_saturation": get_float("LockScreen", "saturation", 0.0),
        "clock_position": get("LockScreen.Clock", "position", "top-center"),
        "clock_align": get("LockScreen.Clock", "align", "center"),
        "clock_font": get("LockScreen.Clock", "font-family", "Cracked Code"),
        "clock_size": get_int("LockScreen.Clock", "font-size", 90),
        "clock_weight": get_int("LockScreen.Clock", "font-weight", 900),
        "clock_color": get("LockScreen.Clock", "color", "#FFFFFF"),
        "date_font": get("LockScreen.Date", "font-family", "Oriental Chicken"),
        "date_size": get_int("LockScreen.Date", "font-size", 20),
        "date_weight": get_int("LockScreen.Date", "font-weight", 600),
        "date_color": get("LockScreen.Date", "color", "#FFFFFF"),
        "date_margin_top": get_int("LockScreen.Date", "margin-top", -15),
        "message_display": get_bool("LockScreen.Message", "display", True),
        "message_text": get("LockScreen.Message", "text", "Press any key or click to sign in"),
        "message_color": get("LockScreen.Message", "color", "#FFFFFF"),
        "login_blur": get_int("LoginScreen", "blur", 0),
        "login_brightness": get_float("LoginScreen", "brightness", 0.0),
        "login_saturation": get_float("LoginScreen", "saturation", 0.0),
        "login_position": get("LoginScreen.LoginArea", "position", "center"),
        "login_margin": get_int("LoginScreen.LoginArea", "margin", -1),
        "avatar_shape": get("LoginScreen.LoginArea.Avatar", "shape", "circle"),
        "avatar_border_color": get("LoginScreen.LoginArea.Avatar", "active-border-color", "#FFFFFF"),
        "avatar_border_size": get_int("LoginScreen.LoginArea.Avatar", "active-border-size", 2),
        "username_font": get("LoginScreen.LoginArea.Username", "font-family", "Oriental Chicken"),
        "username_size": get_int("LoginScreen.LoginArea.Username", "font-size", 16),
        "username_color": get("LoginScreen.LoginArea.Username", "color", "#FFFFFF"),
        "password_width": get_int("LoginScreen.LoginArea.PasswordInput", "width", 160),
        "password_height": get_int("LoginScreen.LoginArea.PasswordInput", "height", 32),
        "password_bg": get("LoginScreen.LoginArea.PasswordInput", "background-color", "#000000"),
        "password_color": get("LoginScreen.LoginArea.PasswordInput", "content-color", "#FFFFFF"),
        "password_border_color": get("LoginScreen.LoginArea.PasswordInput", "border-color", "#000000"),
        "password_radius_left": get_int("LoginScreen.LoginArea.PasswordInput", "border-radius-left", 12),
        "password_radius_right": get_int("LoginScreen.LoginArea.PasswordInput", "border-radius-right", 0),
        "button_bg": get("LoginScreen.LoginArea.LoginButton", "background-color", "#FFFFFF"),
