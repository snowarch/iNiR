    }

def build_default_config(item, is_video=False):
    pos = item.get("position", "center")
    clock_pos = "center-left" if pos in ("left", "center-left") else ("center-right" if pos in ("right", "center-right") else "top-center")
    login_pos = "left" if pos in ("left", "center-left") else ("right" if pos in ("right", "center-right") else "center")
    clock_col = item.get("clock_color", "#FFFFFF")
    date_col = item.get("date_color", item.get("accent_color", "#FFFFFF"))
    accent_col = item.get("accent_color", "#00F0FF")
    
    return {
        "background": "",
        "is_video": is_video,
        "lock_blur": 0 if is_video else 20,
        "lock_brightness": -0.05,
        "lock_saturation": 0.0,
        "clock_position": clock_pos,
        "clock_align": "center",
        "clock_font": "Cracked Code",
        "clock_size": 110 if login_pos != "center" else 90,
        "clock_weight": 900,
        "clock_color": clock_col,
        "date_font": "Oriental Chicken",
        "date_size": 22,
        "date_weight": 600,
        "date_color": date_col,
        "date_margin_top": -15,
        "message_display": True,
        "message_text": "Press any key or click to sign in",
        "message_color": accent_col,
        "login_blur": 0,
        "login_brightness": 0.0,
        "login_saturation": 0.0,
        "login_position": login_pos,
        "login_margin": 60 if login_pos != "center" else -1,
        "avatar_shape": "circle",
        "avatar_border_color": accent_col,
        "avatar_border_size": 2,
        "username_font": "Oriental Chicken",
        "username_size": 18,
        "username_color": clock_col,
        "password_width": 170,
        "password_height": 32,
        "password_bg": "#11111B",
        "password_color": "#FFFFFF",
        "password_border_color": accent_col,
        "password_radius_left": 12,
        "password_radius_right": 0,
        "button_bg": accent_col,
        "button_color": "#000000",
        "button_radius_left": 0,
        "button_radius_right": 12
    }

def get_active_preset():
    if not os.path.exists(METADATA_FILE):
        return "default"
    try:
        with open(METADATA_FILE, "r") as f:
            for line in f:
                if line.startswith("ConfigFile="):
                    val = line.strip().split("=")[1]
                    name = os.path.basename(val).replace(".conf", "")
                    return name
    except Exception:
        pass
    return "default"

def list_local_presets():
    active = get_active_preset()
    presets = []
    if not os.path.exists(CONFIGS_DIR):
        return {"active": active, "presets": []}

    for fname in sorted(os.listdir(CONFIGS_DIR)):
        if not fname.endswith(".conf"):
            continue
        pid = fname[:-5]
        conf_path = os.path.join(CONFIGS_DIR, fname)
        
        conf_parsed = parse_sddm_conf(conf_path)
        is_video = conf_parsed["is_video"]
        bg_name = conf_parsed["background"]
        clock_color = conf_parsed["clock_color"]
        date_color = conf_parsed["date_color"]
        pos = conf_parsed["login_position"]

        # Check preview
        preview_path = os.path.join(PREVIEWS_DIR, f"{pid}.png")
        if not os.path.exists(preview_path):
            preview_path = os.path.join(PREVIEWS_DIR, "default.png")

        # Human-readable title
        name = pid.replace("-", " ").replace("_", " ").title()
        subtitle = "Local Preset Layout"
        if is_video:
            subtitle = "Animated 60fps Live Video Loop"
            cat = "video"
        elif "catppuccin" in pid:
            subtitle = "Catppuccin Color Harmony"
            cat = "catppuccin"
        elif any(k in pid for k in ["silvia", "rei", "ken", "anime", "blue-blade"]):
            subtitle = "Anime & JDM Styling"
            cat = "anime"
        else:
            cat = "minimal"

        video_path = ""
        if is_video:
            cand_video = os.path.join(SDDM_DIR, "backgrounds", bg_name)
            if os.path.exists(cand_video):
                video_path = cand_video

        presets.append({
            "id": pid,
            "name": name,
            "subtitle": subtitle,
            "category": cat,
            "tags": ["Local", "Installed", cat.title()],
            "preview": f"file://{preview_path}",
            "is_video": is_video,
            "video_path": video_path,
            "clock_color": clock_color,
            "date_color": date_color,
            "position": pos,
            "installed": True,
            "is_active": (pid == active),
            "config": conf_parsed
        })

    return {
        "active": active,
        "presets": presets
    }

def list_community():
    active = get_active_preset()
    catalog = list(DEFAULT_COMMUNITY_THEMES)

    # Allow extending catalog from cache if user downloaded an external index
    cache_catalog = os.path.join(CACHE_DIR, "community-catalog.json")
    try:
        if os.path.exists(cache_catalog):
            with open(cache_catalog, "r") as cf:
                loaded = json.load(cf)
                if isinstance(loaded, list) and len(loaded) > 0:
                    catalog = loaded
    except Exception:
        pass

    for item in catalog:
        cid = item["id"]
        conf_path = os.path.join(CONFIGS_DIR, f"{cid}.conf")
        item["installed"] = os.path.exists(conf_path)
        item["is_active"] = (cid == active)
        local_preview = os.path.join(PREVIEWS_DIR, f"{cid}.png")
        cache_preview_jpg = os.path.join(CACHE_DIR, "previews", f"{cid}.jpg")
        cache_preview_png = os.path.join(CACHE_DIR, "previews", f"{cid}.png")
        if os.path.exists(local_preview):
            item["preview"] = f"file://{local_preview}"
        elif os.path.exists(cache_preview_jpg):
            item["preview"] = f"file://{cache_preview_jpg}"
        elif os.path.exists(cache_preview_png):
            item["preview"] = f"file://{cache_preview_png}"
        else:
            item["preview"] = item.get("preview_url", "")

        cand_vid = os.path.join(SDDM_DIR, "backgrounds", f"{cid}.mp4")
        if item.get("is_video") and os.path.exists(cand_vid):
            item["video_path"] = cand_vid
        else:
            item["video_path"] = ""

        if os.path.exists(conf_path):
            item["config"] = parse_sddm_conf(conf_path)
        else:
            item["config"] = build_default_config(item, is_video=item.get("is_video", False))

    return {
        "active": active,
        "presets": catalog
    }

def search_wallhaven(query, page=1, limit=24):
    q = urllib.parse.quote(query.strip() or "cyberpunk")
    url = f"https://wallhaven.cc/api/v1/search?q={q}&categories=111&purity=100&sorting=toplist&page={page}&limit={limit}"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"})
    results = []
    active = get_active_preset()
    
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode())
            for item in data.get("data", []):
                wh_id = str(item.get("id", ""))
                pid = f"wallhaven-{wh_id}"
                conf_exists = os.path.exists(os.path.join(CONFIGS_DIR, f"{pid}.conf"))
                
                wh_item = {
                    "id": pid,
                    "wh_id": wh_id,
                    "name": f"Wallhaven #{wh_id}",
                    "subtitle": f"{item.get('dimension_x', 1920)}×{item.get('dimension_y', 1080)} {item.get('category', 'Anime').title()}",
                    "category": "wallhaven",
                    "tags": ["Wallhaven", item.get("category", "General"), f"{item.get('resolution', '')}"],
                    "preview": item.get("thumbs", {}).get("large", ""),
                    "bg_url": item.get("path", ""),
                    "colors": item.get("colors", []),
                    "is_video": False,
                    "installed": conf_exists,
                    "is_active": (pid == active)
                }
                conf_p = os.path.join(CONFIGS_DIR, f"{pid}.conf")
                if conf_exists:
                    wh_item["config"] = parse_sddm_conf(conf_p)
                else:
                    wh_item["config"] = build_default_config(wh_item, is_video=False)
                results.append(wh_item)
    except Exception as e:
        return {"error": str(e), "presets": []}

    return {"active": active, "presets": results, "page": page}

def search_live(query, page=1):
    q = query.strip()
    if q:
        url = f"https://motionbgs.com/search?q={urllib.parse.quote(q)}" + (f"&page={page}" if page > 1 else "")
    else:
        url = f"https://motionbgs.com/tag:anime/" + (f"{page}/" if page > 1 else "")
        
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"})
    results = []
    active = get_active_preset()

    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            raw = resp.read().decode("utf-8", errors="ignore")
            pattern = r"<a title=\"([^\"]*)\" href=/([a-z0-9][a-z0-9-]*)>([\s\S]*?)</a>"
            matches = re.findall(pattern, raw)
            for title, slug, body in matches:
                media = re.search(r"/i/c/\d+x\d+/media/(\d+)/([^ >\"]+?\.(?:jpg|jpeg|png))", body)
                if not media:
                    continue
                vid_id, file = media.groups()
                stem = re.sub(r"(\.\d+x\d+)?\.(jpg|jpeg|png)$", "", file)
                preview = f"https://motionbgs.com/media/{vid_id}/{stem}.3840x2160.jpg"
                dl_url = f"https://motionbgs.com/dl/hd/{vid_id}/"
                pid = f"motionbgs-{vid_id}"
                conf_exists = os.path.exists(os.path.join(CONFIGS_DIR, f"{pid}.conf"))

                clean_title = re.sub(r"\s+live wallpaper$", "", title, flags=re.IGNORECASE).strip()

                live_item = {
                    "id": pid,
                    "name": clean_title,
                    "subtitle": "MotionBGs 60fps Live Video Loop",
                    "category": "video",
                    "tags": ["Live Video", "60fps", "MotionBGs"],
                    "preview": preview,
                    "bg_url": dl_url,
                    "is_video": True,
                    "installed": conf_exists,
                    "is_active": (pid == active)
                }
                conf_p = os.path.join(CONFIGS_DIR, f"{pid}.conf")
                if conf_exists:
                    live_item["config"] = parse_sddm_conf(conf_p)
                else:
                    live_item["config"] = build_default_config(live_item, is_video=True)
                results.append(live_item)
    except Exception as e:
        return {"error": str(e), "presets": []}

    return {"active": active, "presets": results, "page": page}

