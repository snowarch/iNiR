def install_theme(theme_id, bg_url, preview_url="", is_video=False, clock_color="#FFFFFF", date_color="#FFFFFF", accent_color="#FFFFFF", position="center", style="auto"):
    os.makedirs(CACHE_DIR, exist_ok=True)
    staging_dir = os.path.join(CACHE_DIR, "staging")
    os.makedirs(staging_dir, exist_ok=True)

    ext = "mp4" if is_video else "jpg"
    parsed_path = urllib.parse.urlparse(bg_url).path
    if not is_video and "." in os.path.basename(parsed_path):
        url_ext = os.path.basename(parsed_path).split(".")[-1].lower()
        if url_ext in ["png", "jpg", "jpeg", "webp"]:
            ext = url_ext

    staged_bg = os.path.join(staging_dir, f"{theme_id}.{ext}")
    staged_preview = os.path.join(staging_dir, f"{theme_id}-preview.png")
    staged_conf = os.path.join(staging_dir, f"{theme_id}.conf")

    dl_cmd = ["curl", "-fsSL", "-A", "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36", bg_url, "-o", staged_bg]
    ret = subprocess.run(dl_cmd)
    if ret.returncode != 0:
        return {"success": False, "error": f"Failed to download background from {bg_url}"}

    if preview_url:
        subprocess.run(["curl", "-fsSL", "-A", "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36", preview_url, "-o", staged_preview])

    conf_content = generate_conf_content(
        preset_id=theme_id,
        bg_filename=f"{theme_id}.{ext}",
        is_video=is_video,
        clock_color=clock_color,
        date_color=date_color,
        accent_color=accent_color,
        position=position,
        base_style=style
    )
    with open(staged_conf, "w", encoding="utf-8") as cf:
        cf.write(conf_content)

    ok, err = run_install_action(theme_id, staged_conf, staged_bg, staged_preview if os.path.exists(staged_preview) else "")
    if not ok:
        return {"success": False, "error": err or "Installation failed"}

    return {"success": True, "preset": theme_id, "message": f"Theme {theme_id} installed and activated"}

def apply_background(bg_url, is_video=False, preview_url="", target_preset=""):
    if not target_preset or target_preset == "active":
        target_preset = get_active_preset()

    os.makedirs(CACHE_DIR, exist_ok=True)
    staging_dir = os.path.join(CACHE_DIR, "staging")
    os.makedirs(staging_dir, exist_ok=True)

    ext = "mp4" if is_video else "jpg"
    parsed_path = urllib.parse.urlparse(bg_url).path
    if not is_video and "." in os.path.basename(parsed_path):
        url_ext = os.path.basename(parsed_path).split(".")[-1].lower()
        if url_ext in ["png", "jpg", "jpeg", "webp"]:
            ext = url_ext

    staged_bg = os.path.join(staging_dir, f"{target_preset}.{ext}")
    staged_preview = os.path.join(staging_dir, f"{target_preset}-preview.png")
    staged_conf = os.path.join(staging_dir, f"{target_preset}.conf")

    dl_cmd = ["curl", "-fsSL", "-A", "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36", bg_url, "-o", staged_bg]
    ret = subprocess.run(dl_cmd)
    if ret.returncode != 0:
        return {"success": False, "error": f"Failed to download background from {bg_url}"}

    if preview_url:
        subprocess.run(["curl", "-fsSL", "-A", "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36", preview_url, "-o", staged_preview])

    conf_content = generate_conf_content(
        preset_id=target_preset,
        bg_filename=f"{target_preset}.{ext}",
        is_video=is_video,
        base_style=target_preset
    )
    with open(staged_conf, "w", encoding="utf-8") as cf:
        cf.write(conf_content)

    ok, err = run_install_action(target_preset, staged_conf, staged_bg, staged_preview if os.path.exists(staged_preview) else "")
    if not ok:
        return {"success": False, "error": err or "Applying wallpaper failed"}

    return {"success": True, "preset": target_preset, "message": f"Applied background to preset {target_preset}"}

def run_install_action(preset_id, staged_conf, staged_bg, staged_preview=""):
    if os.path.exists("/usr/local/bin/install-sddm-preset"):
        args = ["/usr/local/bin/install-sddm-preset", preset_id, staged_conf, staged_bg, staged_preview]
        res = subprocess.run(["sudo", "-n"] + args, capture_output=True, text=True)
        if res.returncode == 0:
            return True, ""
        if os.path.exists("/usr/bin/pkexec"):
            res = subprocess.run(["pkexec"] + args, capture_output=True, text=True)
            if res.returncode == 0:
                return True, ""
        return False, res.stderr.strip()

    bg_ext = os.path.splitext(staged_bg)[1].lower()
    target_bg = os.path.join(BACKGROUNDS_DIR, f"{preset_id}{bg_ext}")
    target_conf = os.path.join(CONFIGS_DIR, f"{preset_id}.conf")
    target_preview = os.path.join(PREVIEWS_DIR, f"{preset_id}.png")

    script = f"""
    mkdir -p '{BACKGROUNDS_DIR}' '{CONFIGS_DIR}' '{PREVIEWS_DIR}'
    cp -f '{staged_bg}' '{target_bg}'
    chmod 644 '{target_bg}'
    cp -f '{staged_conf}' '{target_conf}'
    chmod 644 '{target_conf}'
    if [ -f '{staged_preview}' ]; then
        cp -f '{staged_preview}' '{target_preview}'
        chmod 644 '{target_preview}'
    fi
    sed -i 's|^ConfigFile=.*|ConfigFile=configs/{preset_id}.conf|' '{METADATA_FILE}'
    """
    res = subprocess.run(["sudo", "-n", "bash", "-c", script], capture_output=True, text=True)
    if res.returncode == 0:
        return True, ""
    if os.path.exists("/usr/bin/pkexec"):
        res = subprocess.run(["pkexec", "bash", "-c", script], capture_output=True, text=True)
        if res.returncode == 0:
            return True, ""
    return False, res.stderr.strip() or "Failed to install theme files"

def apply_preset(preset_id):
    conf_target = os.path.join(CONFIGS_DIR, f"{preset_id}.conf")
    if not os.path.exists(conf_target):
        return {"success": False, "error": f"Config {conf_target} not found"}

    if os.access(METADATA_FILE, os.W_OK):
        try:
            with open(METADATA_FILE, "r") as f:
                lines = f.readlines()
            with open(METADATA_FILE, "w") as f:
                for line in lines:
                    if line.startswith("ConfigFile="):
                        f.write(f"ConfigFile=configs/{preset_id}.conf\n")
                    else:
                        f.write(line)
            return {"success": True, "preset": preset_id}
        except Exception:
            pass

    if os.path.exists("/usr/local/bin/set-sddm-preset"):
        cmd = ["/usr/local/bin/set-sddm-preset", preset_id]
    else:
        cmd = ["sed", "-i", f"s|^ConfigFile=.*|ConfigFile=configs/{preset_id}.conf|", METADATA_FILE]

    res = subprocess.run(["sudo", "-n"] + cmd, capture_output=True, text=True)
    if res.returncode == 0:
        return {"success": True, "preset": preset_id}

    if os.path.exists("/usr/bin/pkexec"):
        res = subprocess.run(["pkexec"] + cmd, capture_output=True, text=True)
        if res.returncode == 0:
            return {"success": True, "preset": preset_id}

    return {"success": False, "error": res.stderr.strip() or "Permission denied updating metadata.desktop"}

def main():
    parser = argparse.ArgumentParser(description="iNiR SDDM Theme Hub CLI & API Engine")
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("list-local")
    subparsers.add_parser("list-community")

    p_wh = subparsers.add_parser("search-wallhaven")
    p_wh.add_argument("query", nargs="?", default="cyberpunk")
    p_wh.add_argument("--page", type=int, default=1)
    p_wh.add_argument("--limit", type=int, default=24)

    p_live = subparsers.add_parser("search-live")
    p_live.add_argument("query", nargs="?", default="")
    p_live.add_argument("--page", type=int, default=1)

    p_apply = subparsers.add_parser("apply")
    p_apply.add_argument("preset_id")

    p_apply_bg = subparsers.add_parser("apply-bg")
    p_apply_bg.add_argument("--bg-url", required=True)
    p_apply_bg.add_argument("--preview-url", default="")
    p_apply_bg.add_argument("--is-video", action="store_true")
    p_apply_bg.add_argument("--target-preset", default="")

    p_install = subparsers.add_parser("install")
    p_install.add_argument("--id", required=True)
    p_install.add_argument("--bg-url", required=True)
    p_install.add_argument("--preview-url", default="")
    p_install.add_argument("--is-video", action="store_true")
    p_install.add_argument("--clock-color", default="#FFFFFF")
    p_install.add_argument("--date-color", default="#FFFFFF")
    p_install.add_argument("--accent-color", default="#00F0FF")
    p_install.add_argument("--position", default="center")
    p_install.add_argument("--style", default="auto")

    args = parser.parse_args()

    if args.command == "list-local":
        print(json.dumps(list_local_presets(), indent=2))
    elif args.command == "list-community":
        print(json.dumps(list_community(), indent=2))
    elif args.command == "search-wallhaven":
        print(json.dumps(search_wallhaven(args.query, args.page, args.limit), indent=2))
    elif args.command == "search-live":
        print(json.dumps(search_live(args.query, args.page), indent=2))
    elif args.command == "apply":
        print(json.dumps(apply_preset(args.preset_id), indent=2))
    elif args.command == "apply-bg":
        print(json.dumps(apply_background(
            bg_url=args.bg_url,
            is_video=args.is_video,
            preview_url=args.preview_url,
            target_preset=args.target_preset
        ), indent=2))
    elif args.command == "install":
        print(json.dumps(install_theme(
            theme_id=args.id,
            bg_url=args.bg_url,
            preview_url=args.preview_url,
            is_video=args.is_video,
            clock_color=args.clock_color,
            date_color=args.date_color,
            accent_color=args.accent_color,
            position=args.position,
            style=args.style
        ), indent=2))
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
