    style_aliases = {
        "center": "default",
        "left": "default-left",
        "right": "default-right",
        "silvia": "silvia",
        "rei": "rei",
        "blue-blade": "blue-blade-live",
        "blue-blade-live": "blue-blade-live",
        "catppuccin": "catppuccin-mocha",
        "catppuccin-mocha": "catppuccin-mocha",
        "cyberpunk": "cyberpunk-edge",
        "cyberpunk-edge": "cyberpunk-edge",
        "gruvbox": "gruvbox-retro",
        "gruvbox-retro": "gruvbox-retro"
    }
    if base_style in style_aliases:
        base_style = style_aliases[base_style]
    elif base_style == "active":
        base_style = get_active_preset()

    base_conf_path = os.path.join(CONFIGS_DIR, f"{base_style}.conf") if base_style and base_style != "auto" else ""

    if base_conf_path and os.path.exists(base_conf_path):
        try:
            with open(base_conf_path, "r", encoding="utf-8", errors="ignore") as bf:
                base_text = bf.read()
            
            placeholder = f"{preset_id}.png" if is_video else '""'
            
